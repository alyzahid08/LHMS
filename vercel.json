{
  "buildCommand": "vite build && esbuild server/_core/vercelHandler.ts --bundle --platform=node --format=esm --target=node20 --packages=external --alias:@shared=./shared --outfile=api/index.js",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
